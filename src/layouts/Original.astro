---
// Общий макет сайта в оригинальном виде. Стили — те, что были на WordPress + Elementor
// (src/styles/original/); свой набор подключает каждая страница: home.css, blog.css, post.css.
// Шапки на сайте нет — у главной она внутри страницы, у блога и статей её не было.
// Подвал «Деталі співпраці» общий для всех страниц, как в оригинале.
import Seo from '../components/Seo.astro';
import SiteFooter from '../components/original/SiteFooter.astro';
import { HTML_LANG, type Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  image?: string;
  alternates?: Partial<Record<Lang, string>>;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Классы body — как у оригинала: на них завязаны фон, шрифты и ширина контейнеров */
  bodyClass: string;
  /** id основного блока страницы — куда ведёт ссылка «к содержимому» */
  mainId: string;
  preloadFont?: boolean;
}

const {
  title, description = '', lang, image, alternates = {}, type = 'website', noindex = false,
  bodyClass, mainId, preloadFont = false,
} = Astro.props;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <Seo {title} {description} {lang} {image} {alternates} {type} {noindex} {preloadFont} />
    <slot name="head" />
  </head>
  <body id="body" class={`${bodyClass} wp-embed-responsive theme-default elementor-default elementor-kit-6`}>
    <a class="skip-link screen-reader-text" href={`#${mainId}`}>Skip to content</a>
    <slot />
    <SiteFooter lang={lang} />
  </body>
</html>
