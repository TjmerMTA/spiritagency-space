---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';
import { LANGS, DEFAULT_LANG, home, type Lang } from '../../i18n';
import homeData from '../../data/home.json';

export const getStaticPaths = (() =>
  LANGS.filter((l) => l !== DEFAULT_LANG).map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const d = (homeData as Record<string, any>)[lang];
const alternates = Object.fromEntries(LANGS.map((l) => [l, home(l)]));
---

<Base title={d.title} description={d.description} lang={lang} alternates={alternates}>
  <Home lang={lang} />
</Base>
