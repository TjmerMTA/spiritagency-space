---
import type { GetStaticPaths } from 'astro';
import HomePage from '../../components/original/HomePage.astro';
import { LANGS, DEFAULT_LANG, type Lang } from '../../i18n';

export const getStaticPaths = (() =>
  LANGS.filter((l) => l !== DEFAULT_LANG).map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
---

<HomePage lang={lang} />
