---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BlogPage from '../../../components/original/BlogPage.astro';
import { LANGS, DEFAULT_LANG, blogRoot, byDate, type Lang } from '../../../i18n';
import { pages } from '../../../paginate';

export const getStaticPaths = (async () => {
  const all = await getCollection('posts', (p) => !p.data.draft);
  return LANGS.filter((l) => l !== DEFAULT_LANG).flatMap((lang) => {
    const posts = all.filter((p) => p.data.lang === lang).sort(byDate);
    return pages(posts, blogRoot(lang)).map(({ suffix, page }) => ({
      params: { lang, page: suffix },
      props: { page },
    }));
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const lang = Astro.params.lang as Lang;
---

<BlogPage lang={lang} page={page} />
