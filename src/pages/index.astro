---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import { LANGS, home } from '../i18n';
import homeData from '../data/home.json';

const lang = 'uk' as const;
const d = (homeData as Record<string, any>)[lang];
const alternates = Object.fromEntries(LANGS.map((l) => [l, home(l)]));
---

<Base title={d.title} description={d.description} lang={lang} alternates={alternates}>
  <Home lang={lang} />
</Base>
