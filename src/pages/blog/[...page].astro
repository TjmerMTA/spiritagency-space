---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BlogPage from '../../components/original/BlogPage.astro';
import { byDate } from '../../i18n';
import { pages } from '../../paginate';

export const getStaticPaths = (async () => {
  const posts = (await getCollection('posts', (p) => p.data.lang === 'uk' && !p.data.draft)).sort(byDate);
  return pages(posts, '/blog/').map(({ suffix, page }) => ({
    params: { page: suffix },
    props: { page },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BlogPage lang="uk" page={page} />
