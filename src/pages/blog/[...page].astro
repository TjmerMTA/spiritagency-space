---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import { LANGS, UI, blogRoot } from '../../i18n';
import { pages } from '../../paginate';

export const getStaticPaths = (async () => {
  const posts = (await getCollection('posts', (p) => p.data.lang === 'uk' && !p.data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return pages(posts, '/blog/').map(({ suffix, page }) => ({
    params: { page: suffix },
    props: { page },
  }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const lang = 'uk' as const;
const t = UI[lang];
const alternates = Object.fromEntries(LANGS.map((l) => [l, blogRoot(l)]));
const suffix = page.currentPage > 1 ? ` — ${t.page} ${page.currentPage}` : '';
---

<Base
  title={`${t.blogTitle}${suffix} | SpiritAgency`}
  description={t.blogLead}
  lang={lang}
  alternates={page.currentPage === 1 ? alternates : {}}
  noindex={page.currentPage > 1}
>
  <BlogIndex lang={lang} page={page} />
</Base>
