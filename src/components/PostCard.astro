---
import { postUrl, UI, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description?: string;
  image?: string;
  pubDate: Date;
  eager?: boolean;
}
const { lang, slug, title, description, image, pubDate, eager = false } = Astro.props;
const t = UI[lang];
const href = postUrl(lang, slug);
const iso = pubDate.toISOString().slice(0, 10);
const human = pubDate.toLocaleDateString(lang === 'uk' ? 'uk-UA' : lang, {
  day: 'numeric', month: 'long', year: 'numeric',
});
---

<article class="card post">
  <a class="post__media" href={href} tabindex="-1" aria-hidden="true">
    {image ? (
      <img src={image} alt="" width="640" height="360" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <span class="post__ph">Spirit<b>Agency</b></span>
    )}
  </a>
  <div class="post__body">
    <time class="post__date" datetime={iso}>{human}</time>
    <h3 class="post__title"><a href={href}>{title}</a></h3>
    {description && <p class="post__desc">{description}</p>}
    <span class="post__more">{t.readMore} →</span>
  </div>
</article>

<style>
  .post__media {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--ink-3);
    overflow: hidden;
  }
  .post__media img { inline-size: 100%; block-size: 100%; object-fit: cover; transition: transform .35s ease; }
  .card:hover .post__media img { transform: scale(1.04); }
  .post__ph { display: grid; place-items: center; block-size: 100%; color: var(--muted); font-weight: 800; }
  .post__ph b { color: var(--red); }

  .post__body { padding: 1.15rem 1.25rem 1.35rem; display: flex; flex-direction: column; gap: .45rem; flex: 1; }
  .post__date { font-size: .78rem; color: var(--muted); letter-spacing: .04em; }
  .post__title { font-size: 1.12rem; margin: 0; line-height: 1.3; }
  .post__title a::after { content: ''; position: absolute; inset: 0; }
  .card { position: relative; }
  .post__desc {
    color: var(--muted);
    font-size: .93rem;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post__more { margin-block-start: auto; padding-block-start: .6rem; color: var(--red); font-size: .88rem; font-weight: 700; }
</style>
